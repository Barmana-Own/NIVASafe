{
  "id": "/",
  "name": "NIVASafe",
  "short_name": "NIVASafe",
  "description": "پلتفرم هوشمند مدیریت ایمنی، ارزیابی ریسک و بهداشت حرفه‌ای",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f9fc",
  "theme_color": "#144a84",
  "lang": "fa",
  "dir": "rtl",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "داشبورد", "short_name": "داشبورد", "url": "/", "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "ارزیابی FMEA", "short_name": "FMEA", "url": "/fmea", "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "دستیار هوشمند", "short_name": "دستیار", "url": "/assistant", "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ]
}
