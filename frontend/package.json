{
  "name": "@nivasafe/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert \"@visual|@overflow\"",
    "test:overflow": "playwright test --grep @overflow",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "playwright:install:chromium": "playwright install chromium"
  },
  "dependencies": {
    "@nivasafe/domain": "workspace:*",
    "@vitejs/plugin-react": "^4.6.0",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.1.0",
    "vite": "^7.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
