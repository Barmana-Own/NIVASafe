NODE_ENV=production
APP_VERSION=1.0.0
PORT=5044
HOST=127.0.0.1
LOGIN_RATE_LIMIT_MAX=60
APP_URL=https://app.nivasafe.com

MYSQL_DATABASE=nivasafe
MYSQL_USER=nivasafe
MYSQL_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_ANOTHER_LONG_RANDOM_PASSWORD
MYSQL_PORT=3306
DATABASE_URL=mysql://nivasafe:CHANGE_TO_A_LONG_RANDOM_PASSWORD@127.0.0.1:3306/nivasafe

JWT_ACCESS_SECRET=CHANGE_TO_RANDOM_64_CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_TO_RANDOM_64_CHAR_REFRESH_SECRET

LOCAL_UPLOAD_DIR=./uploads
# Optional S3-compatible storage (when set, local storage is not used)
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=nivasafe
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

REDIS_URL=redis://127.0.0.1:6379
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
SMTP_FROM=NIVASafe <no-reply@example.com>

# Subscription checkout adapter. Use an approved payment adapter in production.
SUBSCRIPTION_PAYMENT_MODE=external

AI_DEFAULT_PROVIDER=fallback
AI_ENABLED=false
# Set AI_ENABLED=true and configure at least one provider to enable external AI.
AI_RISK_PROVIDER=arvancloud
AI_RISK_MODEL=GPT-5-Mini
AI_RISK_FALLBACK_PROVIDER=arvancloud
AI_RISK_FALLBACK_MODEL=GPT-5-Mini
AI_CHAT_PROVIDER=arvancloud
AI_CHAT_MODEL=DeepSeek-V4-Flash
# Chat responses use a lower cap by default to reduce time-to-first-answer.
AI_CHAT_MAX_OUTPUT_TOKENS=900
AI_MAX_OUTPUT_TOKENS=1600
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_RETRY_DELAY_MS=250
ARVAN_API_KEY=
ARVAN_BASE_URL=https://api.arvancloudai.ir/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=

# Run once with: pnpm db:provision
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD_12_CHARS_MIN
SEED_ADMIN_NAME=NIVASafe Administrator
SEED_ORG_NAME_FA=سازمان اصلی
SEED_ORG_NAME_EN=Main Organization
