# Docker Compose production example for NIVASafe
NODE_ENV=production
APP_VERSION=1.0.0
APP_URL=https://app.nivasafe.com
WEB_PORT=5043
LOGIN_RATE_LIMIT_MAX=60

MYSQL_DATABASE=nivasafe
MYSQL_USER=nivasafe
MYSQL_PASSWORD=CHANGE_TO_A_URL_SAFE_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_ANOTHER_RANDOM_PASSWORD
MYSQL_PORT=3306
# In Docker, the host MUST be the service name mysql, not 127.0.0.1.
# URL-encode special characters in username/password.
DATABASE_URL=mysql://nivasafe:CHANGE_TO_A_URL_SAFE_RANDOM_PASSWORD@mysql:3306/nivasafe

JWT_ACCESS_SECRET=CHANGE_TO_RANDOM_64_CHAR_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_TO_RANDOM_64_CHAR_REFRESH_SECRET

SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
SMTP_FROM=NIVASafe <no-reply@example.com>
SUBSCRIPTION_PAYMENT_MODE=external

AI_DEFAULT_PROVIDER=fallback
AI_ENABLED=false
# Set AI_ENABLED=true and configure at least one provider to enable external AI.
AI_RISK_PROVIDER=arvancloud
AI_RISK_MODEL=DeepSeek-V4-Flash
AI_RISK_FALLBACK_PROVIDER=arvancloud
AI_RISK_FALLBACK_MODEL=GPT-4o
AI_CHAT_PROVIDER=arvancloud
AI_CHAT_MODEL=GPT-4o
# Chat responses use a lower cap by default to reduce time-to-first-answer.
AI_CHAT_MAX_OUTPUT_TOKENS=900
AI_MAX_OUTPUT_TOKENS=1600
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_RETRY_DELAY_MS=250
ARVAN_API_KEY=
ARVAN_BASE_URL=https://api.arvancloudai.ir/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=

# Run once after containers are healthy:
# docker compose exec -e SEED_ADMIN_EMAIL=admin@example.com \
#   -e SEED_ADMIN_PASSWORD='A-Strong-Password-12+' \
#   -e SEED_ADMIN_NAME='NIVASafe Administrator' \
#   -e SEED_ORG_NAME_FA='سازمان اصلی' \
#   api ./node_modules/.bin/tsx prisma/provision.ts
