# Production TLS template for app.nivasafe.com.
# Install a valid certificate (for example via certbot) before enabling this file.
server {
  listen 80;
  server_name nivasafe.com www.nivasafe.com nivasafe.ir www.nivasafe.ir app.nivasafe.ir;
  return 301 https://app.nivasafe.com$request_uri;
}

server {
  listen 80;
  server_name app.nivasafe.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name app.nivasafe.com;
  ssl_certificate /etc/letsencrypt/live/app.nivasafe.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/app.nivasafe.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:TLS:10m;
  ssl_session_timeout 10m;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
  location /api/ { proxy_pass http://api; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Request-ID $request_id; }
  location /docs { proxy_pass http://api; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; }
  location / { proxy_pass http://web; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; }
}
