worker_processes 1;
error_log logs/error.log warn;
pid logs/nginx.pid;

events { worker_connections 1024; }

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    server_tokens off;
    client_max_body_size 32m;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80 default_server;
        server_name _;
        location /.well-known/acme-challenge/ {
            root C:/inetpub/acme;
        }
        location / {
            return 301 https://app.nivasafe.com$request_uri;
        }
    }

    server {
        listen 80;
        server_name app.nivasafe.com;
        location /.well-known/acme-challenge/ {
            root C:/inetpub/acme;
        }
        location / {
            return 301 https://app.nivasafe.com$request_uri;
        }
    }

    server {
        listen 80;
        server_name api.nivasafe.com;
        location /.well-known/acme-challenge/ {
            root C:/inetpub/acme;
        }
        location / {
            return 301 https://api.nivasafe.com$request_uri;
        }
    }

    server {
        listen 80;
        server_name nivasafe.com www.nivasafe.com nivasafe.ir www.nivasafe.ir app.nivasafe.ir;
        location /.well-known/acme-challenge/ {
            root C:/inetpub/acme;
        }
        location / {
            return 301 https://app.nivasafe.com$request_uri;
        }
    }

    server {
        listen 80;
        server_name api.nivasafe.ir;
        location /.well-known/acme-challenge/ {
            root C:/inetpub/acme;
        }
        location / {
            return 301 https://api.nivasafe.com$request_uri;
        }
    }

    server {
        listen 443 ssl;
        server_name app.nivasafe.com;
        ssl_certificate     C:/Runtime/nginx/certs/nivasafe-com-chain.pem;
        ssl_certificate_key C:/Runtime/nginx/certs/nivasafe-com-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        root C:/inetpub/nivasafe/app-com;
        index index.html;

        location = /sw.js {
            default_type application/javascript;
            try_files $uri =404;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        }

        location = /manifest.webmanifest {
            default_type application/manifest+json;
            try_files $uri =404;
            add_header Cache-Control "no-cache" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        }

        location /.well-known/acme-challenge/ {
            root C:/inetpub/acme;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:5044;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }

    server {
        listen 443 ssl;
        server_name api.nivasafe.com;
        ssl_certificate     C:/Runtime/nginx/certs/nivasafe-com-chain.pem;
        ssl_certificate_key C:/Runtime/nginx/certs/nivasafe-com-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        location /.well-known/acme-challenge/ {
            root C:/inetpub/acme;
        }
        location / {
            proxy_pass http://127.0.0.1:5044;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }
    }

    server {
        listen 443 ssl;
        server_name nivasafe.com www.nivasafe.com;
        ssl_certificate     C:/Runtime/nginx/certs/nivasafe-com-chain.pem;
        ssl_certificate_key C:/Runtime/nginx/certs/nivasafe-com-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        return 301 https://app.nivasafe.com$request_uri;
    }

    server {
        listen 443 ssl;
        server_name nivasafe.ir www.nivasafe.ir app.nivasafe.ir;
        ssl_certificate     C:/Runtime/nginx/certs/nivasafe-com-chain.pem;
        ssl_certificate_key C:/Runtime/nginx/certs/nivasafe-com-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        return 301 https://app.nivasafe.com$request_uri;
    }

    server {
        listen 443 ssl;
        server_name api.nivasafe.ir;
        ssl_certificate     C:/Runtime/nginx/certs/nivasafe-com-chain.pem;
        ssl_certificate_key C:/Runtime/nginx/certs/nivasafe-com-key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        return 301 https://api.nivasafe.com$request_uri;
    }
}
