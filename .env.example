NODE_ENV=development
APP_NAME=NIVASafe
APP_URL=http://localhost:5043
API_URL=http://localhost:5044/api/v1
VITE_API_URL=http://localhost:5044/api/v1
PORT=5044

# XAMPP MySQL / MariaDB (default local root account has no password)
DATABASE_URL=mysql://root@127.0.0.1:3306/nivasafe
XAMPP_MYSQL_HOST=127.0.0.1
XAMPP_MYSQL_PORT=3306
XAMPP_MYSQL_DATABASE=nivasafe
XAMPP_MYSQL_USER=root
XAMPP_MYSQL_PASSWORD=

# Local development does not require Redis or MinIO.
REDIS_URL=
S3_ENDPOINT=
LOCAL_UPLOAD_DIR=uploads

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
APP_ENCRYPTION_KEY=replace-with-32-byte-key

SMTP_URL=
SMTP_FROM=NIVASafe <no-reply@example.com>
AI_ENABLED=false
AI_DEFAULT_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
