NODE_ENV=development
APP_NAME=NIVASafe
APP_URL=http://localhost:5043
API_URL=http://localhost:5044/api/v1
VITE_API_URL=http://localhost:5044/api/v1
PORT=5044
# Production only: local development uses the application-wide one-minute limiter.
LOGIN_RATE_LIMIT_MAX=60

# XAMPP MySQL / MariaDB (default local root account has no password)
DATABASE_URL=mysql://root@127.0.0.1:3306/nivasafe
XAMPP_MYSQL_HOST=127.0.0.1
XAMPP_MYSQL_PORT=3306
XAMPP_MYSQL_DATABASE=nivasafe
XAMPP_MYSQL_USER=root
XAMPP_MYSQL_PASSWORD=

# Local development does not require Redis or MinIO.
REDIS_URL=
S3_ENDPOINT=
LOCAL_UPLOAD_DIR=uploads

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
APP_ENCRYPTION_KEY=replace-with-32-byte-key

SMTP_URL=
SMTP_FROM=NIVASafe <no-reply@example.com>
AI_ENABLED=false
AI_DEFAULT_PROVIDER=fallback
AI_RISK_PROVIDER=arvancloud
AI_RISK_MODEL=GPT-5-Mini
AI_RISK_FALLBACK_PROVIDER=arvancloud
AI_RISK_FALLBACK_MODEL=GPT-5-Mini
AI_CHAT_PROVIDER=arvancloud
AI_CHAT_MODEL=DeepSeek-V4-Flash
# Chat responses use a lower cap by default to reduce time-to-first-answer.
AI_CHAT_MAX_OUTPUT_TOKENS=900
AI_MAX_OUTPUT_TOKENS=1600
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_RETRY_DELAY_MS=250
ARVAN_API_KEY=
ARVAN_BASE_URL=https://api.arvancloudai.ir/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
