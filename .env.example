# Sanitized export copy: configure secret values securely before use.
NODE_ENV=development
APP_NAME=NIVASafe
APP_URL=http://localhost:5043
API_URL=http://localhost:5044/api/v1
VITE_API_URL=http://localhost:5044/api/v1
PORT=5044
# Production only: local development uses the application-wide one-minute limiter.
LOGIN_RATE_LIMIT_MAX=60

# XAMPP MySQL / MariaDB (default local root account has no password)
DATABASE_URL=mysql://root@127.0.0.1:3306/nivasafe
XAMPP_MYSQL_HOST=127.0.0.1
XAMPP_MYSQL_PORT=3306
XAMPP_MYSQL_DATABASE=nivasafe
XAMPP_MYSQL_USER=root
XAMPP_MYSQL_PASSWORD=

# Local development does not require Redis or MinIO.
REDIS_URL=
S3_ENDPOINT=
LOCAL_UPLOAD_DIR=uploads

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
APP_ENCRYPTION_KEY=replace-with-32-byte-key

SMTP_URL=
SMTP_FROM=NIVASafe <no-reply@example.com>
AI_ENABLED=false
AI_DEFAULT_PROVIDER=fallback
AI_RISK_PROVIDER=arvancloud
AI_RISK_FALLBACK_PROVIDER=arvancloud
AI_CHAT_PROVIDER=arvancloud
# Assessment and conversation model identifiers are fixed in the server code.
# Explicit operator activation is separate from verified vendor processing terms.
# An explicitly empty activation value disables transfers; current account consent is always required.
RULA_IMAGE_PROCESSING_ENABLED_PROVIDER=
FMEA_IMAGE_PROCESSING_ENABLED_PROVIDER=
# Legacy privacy approval remains available for deployments without the explicit activation setting.
# Do not claim verified vendor terms from an operator activation or a successful API call.
# Vision capability is verified by an image integration check, not anatomical accuracy.
# Set privacy only after actual processing terms are established, and vision only after
# an integration check verifies image input plus structured JSON output (not anatomical accuracy).
# RULA approval is one platform-wide provider processing-terms status, never a tenant allowlist.
# Account consent is separate and checked from current versioned database receipts on every transfer.
# Do not set the privacy value from API success or user consent alone; see docs/legal/rula-provider-required-evidence.2026-10-22.md.
RULA_IMAGE_PRIVACY_APPROVED_PROVIDER=
RULA_IMAGE_VISION_SUPPORTED_PROVIDER=
# Optional server-local landmark detection; files must be provisioned before enabling.
RULA_LOCAL_POSE_ENABLED=false
RULA_POSE_PYTHON=
RULA_POSE_WORKER_PATH=
RULA_POSE_MODEL_PATH=
RULA_POSE_MODEL_SHA256=
FMEA_IMAGE_PRIVACY_APPROVED_PROVIDER=
FMEA_IMAGE_VISION_SUPPORTED_PROVIDER=
# Chat responses use a lower cap by default to reduce time-to-first-answer.
AI_CHAT_MAX_OUTPUT_TOKENS=900
AI_MAX_OUTPUT_TOKENS=1600
AI_PROVIDER_TIMEOUT_MS=30000
RULA_IMAGE_PROVIDER_TIMEOUT_MS=120000
FMEA_IMAGE_PROVIDER_TIMEOUT_MS=120000
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_RETRY_DELAY_MS=250
ARVAN_API_KEY=
ARVAN_BASE_URL=https://api.arvancloudai.ir/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
