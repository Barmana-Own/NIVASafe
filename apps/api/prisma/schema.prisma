generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  HSE_MANAGER
  ASSESSOR
  VIEWER
}

enum Status {
  DRAFT
  IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_REVIEW
  COMPLETED
  REJECTED
  OVERDUE
  CANCELLED
}

enum AIRequestStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  WAITING_FOR_PROVIDER
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AttachmentKind {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id           String               @id @default(uuid()) @db.VarChar(36)
  email        String               @unique
  passwordHash String
  displayName  String
  active       Boolean              @default(true)
  lastLoginAt  DateTime?
  locale       String               @default("fa")
  phone        String?
  jobTitle     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
  sessions     Session[]
  auditLogs    AuditLog[]
  passwordResetTokens PasswordResetToken[]
  uploadedAttachments Attachment[]
  conversations ChatConversation[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  aiRequests AIAnalysisRequest[]
}

model Session {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Permission {
  id          String           @id @default(uuid()) @db.VarChar(36)
  key         String           @unique
  description String? @db.Text
  roleLinks   RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.VarChar(36)
  role         Role
  permissionId String     @db.VarChar(36)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model Organization {
  id             String               @id @default(uuid()) @db.VarChar(36)
  nameFa         String
  nameEn         String
  nationalId     String?              @unique
  industry       String?
  timezone       String               @default("Asia/Tehran")
  defaultLocale  String               @default("fa")
  riskMedium     Int                  @default(50)
  riskHigh       Int                  @default(100)
  riskCritical   Int                  @default(200)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  projects       Project[]
  processes      Process[]
  activities     Activity[]
  fmeas          FmeaAssessment[]
  rulas          RulaAssessment[]
  actions        CorrectiveAction[]
  knowledge      KnowledgeDocument[]
  notifications  Notification[]
  invitations    Invitation[]
  attachments    Attachment[]
  knowledgeCategories KnowledgeCategory[]
  aiRequests     AIAnalysisRequest[]
  conversations  ChatConversation[]
  notificationPreferences NotificationPreference[]
  emailOutbox    EmailOutbox[]
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  userId         String       @db.VarChar(36)
  role           Role
  active         Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  email          String
  role           Role
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Project {
  id             String             @id @default(uuid()) @db.VarChar(36)
  organizationId String             @db.VarChar(36)
  name           String
  code           String
  status         String             @default("ACTIVE")
  description    String? @db.Text
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id])
  processes      Process[]
  activities     Activity[]
  fmeas          FmeaAssessment[]
  rulas          RulaAssessment[]
  actions        CorrectiveAction[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Process {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  projectId      String       @db.VarChar(36)
  name           String
  description    String? @db.Text
  parentId       String?      @db.VarChar(36)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project      @relation(fields: [projectId], references: [id])
  activities     Activity[]

  @@index([organizationId, projectId])
}

model Activity {
  id             String           @id @default(uuid()) @db.VarChar(36)
  organizationId String           @db.VarChar(36)
  projectId      String           @db.VarChar(36)
  processId      String?          @db.VarChar(36)
  title          String
  jobTitle       String?
  location       String?
  description    String? @db.Text
  hazards        String? @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id])
  project        Project          @relation(fields: [projectId], references: [id])
  process        Process?         @relation(fields: [processId], references: [id])
  fmeas          FmeaAssessment[]
  rulas          RulaAssessment[]

  @@index([organizationId, projectId])
}

model FmeaAssessment {
  id             String             @id @default(uuid()) @db.VarChar(36)
  organizationId String             @db.VarChar(36)
  projectId      String             @db.VarChar(36)
  activityId     String?            @db.VarChar(36)
  title          String
  code           String
  status         Status             @default(DRAFT)
  scope          String? @db.Text
  version        Int                @default(1)
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id])
  project        Project            @relation(fields: [projectId], references: [id])
  activity       Activity?          @relation(fields: [activityId], references: [id])
  items          FmeaItem[]
  actions        CorrectiveAction[]
  versions       FmeaVersion[]

  @@unique([organizationId, code, version])
  @@index([organizationId, projectId])
}

model FmeaVersion {
  id           String         @id @default(uuid()) @db.VarChar(36)
  assessmentId String         @db.VarChar(36)
  version      Int
  snapshot     Json
  createdBy    String?        @db.VarChar(36)
  createdAt    DateTime       @default(now())
  assessment   FmeaAssessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, version])
  @@index([assessmentId, createdAt])
}

model FmeaItem {
  id                 String         @id @default(uuid()) @db.VarChar(36)
  assessmentId       String         @db.VarChar(36)
  rowNumber           Int
  processStep         String @db.Text
  failureMode         String @db.Text
  effect              String @db.Text
  cause               String @db.Text
  preventiveControls  String? @db.Text
  detectionControls   String? @db.Text
  severity            Int
  occurrence          Int
  detection           Int
  rpn                 Int
  riskLevel           RiskLevel
  recommendation      String? @db.Text
  residualSeverity    Int?
  residualOccurrence  Int?
  residualDetection   Int?
  residualRpn         Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  assessment          FmeaAssessment @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
}

model RulaAssessment {
  id             String             @id @default(uuid()) @db.VarChar(36)
  organizationId String             @db.VarChar(36)
  projectId      String             @db.VarChar(36)
  activityId     String?            @db.VarChar(36)
  title          String
  subjectCode    String?
  bodySide       String             @default("RIGHT")
  inputs         Json
  score          Int
  actionLevel    Int
  explanation    String @db.Text
  status         Status             @default(DRAFT)
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  project        Project            @relation(fields: [projectId], references: [id])
  activity       Activity?          @relation(fields: [activityId], references: [id])
  actions        CorrectiveAction[]
  versions       RulaVersion[]

  @@index([organizationId, projectId])
}

model RulaVersion {
  id           String         @id @default(uuid()) @db.VarChar(36)
  assessmentId String         @db.VarChar(36)
  version      Int
  snapshot     Json
  createdBy    String?        @db.VarChar(36)
  createdAt    DateTime       @default(now())
  assessment   RulaAssessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, version])
  @@index([assessmentId, createdAt])
}

model CorrectiveAction {
  id             String          @id @default(uuid()) @db.VarChar(36)
  organizationId String          @db.VarChar(36)
  projectId      String          @db.VarChar(36)
  fmeaId         String?         @db.VarChar(36)
  rulaId         String?         @db.VarChar(36)
  title          String
  description    String @db.Text
  priority       String          @default("MEDIUM")
  status         ActionStatus    @default(OPEN)
  progress       Int             @default(0)
  assigneeName   String?
  dueDate        DateTime?
  beforeRisk     Int?
  afterRisk      Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  project        Project         @relation(fields: [projectId], references: [id])
  fmea           FmeaAssessment? @relation(fields: [fmeaId], references: [id])
  rula           RulaAssessment? @relation(fields: [rulaId], references: [id])

  @@index([organizationId, status])
}

model KnowledgeDocument {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  title          String
  content        String @db.LongText
  tags           Json
  published      Boolean      @default(true)
  categoryId     String?      @db.VarChar(36)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  category       KnowledgeCategory? @relation(fields: [categoryId], references: [id])

  @@index([organizationId])
}

model KnowledgeCategory {
  id             String              @id @default(uuid()) @db.VarChar(36)
  organizationId String              @db.VarChar(36)
  name           String
  description    String? @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id])
  documents      KnowledgeDocument[]

  @@unique([organizationId, name])
}

model Attachment {
  id             String         @id @default(uuid()) @db.VarChar(36)
  organizationId String         @db.VarChar(36)
  uploadedById   String         @db.VarChar(36)
  kind           AttachmentKind
  originalName   String
  objectKey      String         @unique
  mimeType       String
  size           Int
  entityType     String?
  entityId       String?
  checksum       String?
  createdAt      DateTime       @default(now())
  deletedAt      DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id])
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])

  @@index([organizationId, entityType, entityId])
}

model Notification {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  userId         String       @db.VarChar(36)
  title          String
  message        String @db.Text
  link           String? @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model NotificationPreference {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String       @db.VarChar(36)
  userId         String       @db.VarChar(36)
  emailEnabled   Boolean      @default(true)
  pushEnabled    Boolean      @default(false)
  riskAlerts     Boolean      @default(true)
  dueReminders   Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model EmailOutbox {
  id             String       @id @default(uuid()) @db.VarChar(36)
  organizationId String?      @db.VarChar(36)
  recipient      String
  subject        String
  body           String @db.LongText
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String? @db.Text
  nextAttemptAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, nextAttemptAt])
}

model AIAnalysisRequest {
  id             String          @id @default(uuid()) @db.VarChar(36)
  organizationId String          @db.VarChar(36)
  userId         String          @db.VarChar(36)
  type           String
  provider       String          @default("fallback")
  status         AIRequestStatus @default(PENDING)
  input          Json
  output         Json?
  error          String? @db.Text
  attempts       Int             @default(0)
  availableAt    DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  user           User            @relation(fields: [userId], references: [id])

  @@index([organizationId, status, availableAt])
}

model ChatConversation {
  id             String        @id @default(uuid()) @db.VarChar(36)
  organizationId String        @db.VarChar(36)
  userId         String        @db.VarChar(36)
  title          String
  projectId      String?       @db.VarChar(36)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  messages       ChatMessage[]

  @@index([organizationId, userId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.VarChar(36)
  conversationId String           @db.VarChar(36)
  role           String
  content        String @db.LongText
  citations      Json?
  provider       String?
  feedback       Int?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String?  @db.VarChar(36)
  organizationId String?  @db.VarChar(36)
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  requestId      String?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}
