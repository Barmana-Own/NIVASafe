{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {"dependsOn": ["^build"], "outputs": ["dist/**"]},
    "dev": {"cache": false, "persistent": true},
    "lint": {"dependsOn": ["^lint"]},
    "typecheck": {"dependsOn": ["^typecheck"]},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NIVASAFE_PDF_FONT_PATH", "NIVASAFE_PDF_FONT_BOLD_PATH"]
    }
  }
}
