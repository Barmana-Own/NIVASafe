{
  "name": "nivasafe",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @nivasafe/domain build && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @nivasafe/api prisma:generate",
    "db:migrate": "pnpm --filter @nivasafe/api prisma:migrate",
    "db:seed": "pnpm --filter @nivasafe/api prisma:seed",
    "dev:web": "pnpm --filter @nivasafe/web dev",
    "dev:api": "pnpm --filter @nivasafe/api dev",
    "setup:dev": "pnpm --filter @nivasafe/domain build && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "db:push": "pnpm --filter @nivasafe/api prisma:migrate",
    "db:deploy": "pnpm --filter @nivasafe/api prisma:migrate:deploy",
    "db:provision": "pnpm --filter @nivasafe/api prisma:provision",
    "verify:contract": "node scripts/check-api-contract.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "db:backup": "node scripts/mysql-backup.mjs",
    "db:restore": "node scripts/mysql-restore.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  }
}
